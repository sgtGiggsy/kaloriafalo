# =========================
# BASIC SECURITY HARDENING
# =========================

Options -Indexes

# =========================
# BLOCK SENSITIVE FILES
# =========================

<FilesMatch "^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|phpinfo\.php)$">
    Require all denied
</FilesMatch>

# dotfiles védelme
RewriteRule ^\.well-known/traffic-advice$ - [T=application/trafficadvice+json,END]

# =========================
# BLOCK COMMON ATTACK TARGETS
# =========================

RewriteEngine On

RewriteCond %{REQUEST_URI} (^|/)(xmlrpc\.php|wlwmanifest\.xml|wp-login\.php|wp-admin|wp-includes|wp-content|wp-json)(/|$) [NC,OR]
RewriteCond %{REQUEST_URI} (^|/)(wordpress|wp|blog|backup|old|test)(/|$) [NC]
RewriteRule .* - [R=404,L]

# =========================
# BLOCK EXPLOIT PATTERNS IN QUERY STRING
# =========================

RewriteCond %{QUERY_STRING} (\.\./|%2e%2e|union.*select|select.*from|insert.*into|drop.*table|benchmark\(|sleep\() [NC]
RewriteRule .* - [F,L]

# =========================
# BLOCK BAD METHODS (OPTIONAL)
# =========================

RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK) [NC]
RewriteRule .* - [F,L]

# =========================
# BASIC BOT NOISE FILTER
# =========================

RewriteCond %{HTTP_USER_AGENT} (curl|wget|python|nikto|sqlmap|nmap|scanner) [NC]
RewriteRule .* - [R=403,L]

# =========================
# OPTIONAL: MIME sniffing protection
# =========================

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
	
	ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"

    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ttf|otf|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

Options -Indexes
RewriteEngine On
RewriteRule \.(css|jpe?g|gif|png|js|ico)$ - [L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d

RewriteRule ^ - [L]
RewriteRule ^([^/]+)(?:/(.*))?$ index.php?page=$1&params=$2 [L,QSA]